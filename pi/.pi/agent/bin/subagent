#!/usr/bin/env bash
set -u
umask 077

program="${0##*/}"

usage() {
  cat <<'EOF'
Usage:
  subagent launch WORKER [--cwd PATH] [--delay SECONDS] < PROMPT
  subagent resume WORKER < PROMPT
  subagent wait-any
  subagent wait-all
  subagent output WORKER
  subagent exit-code WORKER
  subagent status
  subagent cancel WORKER

Commands:
  launch       Launch a worker and print its name and session ID.
  resume       Run a blocking follow-up turn in an existing worker session.
  wait-any     Wait for and claim one completion, then print the worker name.
  wait-all     Claim all remaining completions and print names as they arrive.
  output       Print a worker's captured initial output.
  exit-code    Print a completed worker's exit code or "cancelled".
  status       Show each worker's current state.
  cancel       Stop a worker and record it as cancelled.

State is scoped by PI_SESSION_ID and stored under:
  ${SUBAGENT_STATE_DIR:-$HOME/.pi/agent/subagents}/<PI_SESSION_ID>/

wait-any exits 0 after claiming a worker, 1 when all workers were already
consumed, and 2 on an error. A claimed worker's marker is moved from exit to
done, so completions remain durable until consumed.
EOF
}

error() {
  printf '%s: %s\n' "$program" "$*" >&2
}

die() {
  error "$@"
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

absolute_dir() {
  (cd "$1" 2>/dev/null && pwd -P)
}

validate_component() {
  case "$2" in
    ''|*[!A-Za-z0-9._-]*|[.-]*) die "invalid $1: $2" ;;
  esac
}

subagent_parent_dir() {
  local parent_session_id="${PI_SESSION_ID:-}"
  local subagent_root="${SUBAGENT_STATE_DIR:-$HOME/.pi/agent/subagents}"

  [ -n "$parent_session_id" ] || die "PI_SESSION_ID is not set"
  validate_component "PI session ID" "$parent_session_id"
  printf '%s/%s\n' "$subagent_root" "$parent_session_id"
}

ensure_parent_dir() {
  local parent_dir
  parent_dir="$(subagent_parent_dir)" || exit $?
  mkdir -p "$parent_dir/workers" "$parent_dir/sessions" ||
    die "cannot create subagent directory: $parent_dir"
  printf '%s\n' "$parent_dir"
}

resolve_parent_dir() {
  local parent_dir
  parent_dir="$(subagent_parent_dir)" || exit $?
  [ -d "$parent_dir/workers" ] || die "this Pi session has no subagent workers"
  printf '%s\n' "$parent_dir"
}

resolve_worker() {
  local parent_dir="$1"
  local worker="$2"
  local worker_dir="$parent_dir/workers/$worker"
  validate_component "worker name" "$worker"
  [ -d "$worker_dir" ] || die "worker does not exist: $worker"
  printf '%s\n' "$worker_dir"
}

launch_worker() {
  [ "$#" -ge 1 ] || die "usage: $program launch WORKER [--cwd PATH] [--delay SECONDS]"

  local worker="$1"
  local cwd="$PWD"
  local delay=0
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cwd)
        [ "$#" -ge 2 ] || die "--cwd requires a path"
        cwd="$2"
        shift 2
        ;;
      --delay)
        [ "$#" -ge 2 ] || die "--delay requires a number of seconds"
        delay="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return
        ;;
      *) die "unknown launch option: $1" ;;
    esac
  done

  validate_component "worker name" "$worker"
  [[ "$delay" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "invalid delay: $delay"
  cwd="$(absolute_dir "$cwd")" || die "working directory does not exist: $cwd"
  require_command pi
  require_command tmux
  require_command uuidgen

  local parent_dir
  local worker_dir
  local pi_session_dir
  local sid
  local tmux_name
  parent_dir="$(ensure_parent_dir)" || exit $?
  worker_dir="$parent_dir/workers/$worker"
  pi_session_dir="$parent_dir/sessions"
  mkdir "$worker_dir" 2>/dev/null || die "worker already exists: $worker"

  sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  tmux_name="pi-subagent-${PI_SESSION_ID}-${worker}"

  printf '%s\n' "$sid" >"$worker_dir/session-id"
  printf '%s\n' "$cwd" >"$worker_dir/cwd"
  printf '%s\n' "$delay" >"$worker_dir/delay"
  printf '%s\n' "$pi_session_dir" >"$worker_dir/pi-session-dir"
  printf '%s\n' "$tmux_name" >"$worker_dir/tmux-name"
  cat >"$worker_dir/prompt"

  cat >"$worker_dir/run.sh" <<'RUNNER'
#!/usr/bin/env bash
set +e

worker_dir="$(cd "$(dirname "$0")" && pwd -P)"
sid="$(cat "$worker_dir/session-id")"
cwd="$(cat "$worker_dir/cwd")"
delay="$(cat "$worker_dir/delay")"
pi_session_dir="$(cat "$worker_dir/pi-session-dir")"
worker="$(basename "$worker_dir")"

sleep "$delay"
if cd "$cwd"; then
  cat "$worker_dir/prompt" |
    pi --session-dir "$pi_session_dir" \
      --session-id "$sid" --name "subagent:$worker" -p \
      >"$worker_dir/output" 2>&1
  rc=$?
else
  printf 'Could not enter working directory: %s\n' "$cwd" >"$worker_dir/output"
  rc=125
fi

printf '%s\n' "$rc" >"$worker_dir/exit.tmp"
mv "$worker_dir/exit.tmp" "$worker_dir/exit"
RUNNER
  chmod +x "$worker_dir/run.sh"

  if ! tmux new-session -d -s "$tmux_name" "$(printf %q "$worker_dir/run.sh")"; then
    printf '%s\n' 125 >"$worker_dir/exit"
    die "failed to launch worker: $worker"
  fi

  printf 'WORKER=%s\nSESSION_ID=%s\n' "$worker" "$sid"
}

resume_worker() {
  [ "$#" -eq 1 ] || die "usage: $program resume WORKER"

  local parent_dir
  local worker_dir
  local pi_session_dir
  local sid
  local cwd
  parent_dir="$(resolve_parent_dir)" || exit $?
  worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?

  if [ ! -f "$worker_dir/exit" ] && [ ! -f "$worker_dir/done" ]; then
    die "worker is still running: $1"
  fi

  require_command pi
  sid="$(cat "$worker_dir/session-id")"
  cwd="$(cat "$worker_dir/cwd")"
  cd "$cwd" || die "working directory does not exist: $cwd"

  if [ -f "$worker_dir/pi-session-dir" ]; then
    pi_session_dir="$(cat "$worker_dir/pi-session-dir")"
    pi --session-dir "$pi_session_dir" --session "$sid" -p
  else
    # Workers created before isolated session storage used Pi's default directory.
    pi --session "$sid" -p
  fi
}

wait_any() {
  [ "$#" -eq 0 ] || die "usage: $program wait-any"

  local parent_dir
  local worker_dir
  local workers
  local unfinished
  parent_dir="$(resolve_parent_dir)" || exit $?

  while :; do
    workers=0
    unfinished=0

    for worker_dir in "$parent_dir/workers"/*; do
      [ -d "$worker_dir" ] || continue
      workers=$((workers + 1))

      if [ -f "$worker_dir/exit" ]; then
        if mv "$worker_dir/exit" "$worker_dir/done" 2>/dev/null; then
          basename "$worker_dir"
          return 0
        fi
      fi

      [ -f "$worker_dir/done" ] || unfinished=$((unfinished + 1))
    done

    [ "$workers" -gt 0 ] || die "this Pi session has no subagent workers"
    [ "$unfinished" -gt 0 ] || return 1
    sleep 0.2
  done
}

wait_all() {
  [ "$#" -eq 0 ] || die "usage: $program wait-all"

  local worker
  local rc
  while :; do
    worker="$(wait_any)"
    rc=$?
    case "$rc" in
      0) printf '%s\n' "$worker" ;;
      1) return 0 ;;
      *) return "$rc" ;;
    esac
  done
}

worker_output() {
  [ "$#" -eq 1 ] || die "usage: $program output WORKER"

  local parent_dir
  local worker_dir
  parent_dir="$(resolve_parent_dir)" || exit $?
  worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?
  [ -f "$worker_dir/output" ] || die "worker has no output yet: $1"
  cat "$worker_dir/output"
}

worker_exit_code() {
  [ "$#" -eq 1 ] || die "usage: $program exit-code WORKER"

  local parent_dir
  local worker_dir
  parent_dir="$(resolve_parent_dir)" || exit $?
  worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?

  if [ -f "$worker_dir/done" ]; then
    cat "$worker_dir/done"
  elif [ -f "$worker_dir/exit" ]; then
    cat "$worker_dir/exit"
  else
    die "worker has not completed: $1"
  fi
}

worker_state() {
  local worker_dir="$1"
  local marker

  if [ -f "$worker_dir/done" ]; then
    marker="$(cat "$worker_dir/done")"
    if [ "$marker" = cancelled ]; then
      printf 'cancelled\t%s\n' "$marker"
    else
      printf 'consumed\t%s\n' "$marker"
    fi
  elif [ -f "$worker_dir/exit" ]; then
    marker="$(cat "$worker_dir/exit")"
    if [ "$marker" = cancelled ]; then
      printf 'cancelled\t%s\n' "$marker"
    else
      printf 'completed\t%s\n' "$marker"
    fi
  else
    printf 'running\t-\n'
  fi
}

run_status() {
  [ "$#" -eq 0 ] || die "usage: $program status"

  local parent_dir
  local worker_dir
  local found=0
  local status_and_exit
  local worker_status
  local code
  parent_dir="$(resolve_parent_dir)" || exit $?

  printf '%-20s %-10s %s\n' WORKER STATE EXIT
  for worker_dir in "$parent_dir/workers"/*; do
    [ -d "$worker_dir" ] || continue
    found=1
    status_and_exit="$(worker_state "$worker_dir")"
    worker_status="${status_and_exit%%	*}"
    code="${status_and_exit#*	}"
    printf '%-20s %-10s %s\n' "$(basename "$worker_dir")" "$worker_status" "$code"
  done

  [ "$found" -eq 1 ] || printf '%s\n' '(no workers)'
}

cancel_worker() {
  [ "$#" -eq 1 ] || die "usage: $program cancel WORKER"

  local parent_dir
  local worker_dir
  local tmux_name
  parent_dir="$(resolve_parent_dir)" || exit $?
  worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?

  if [ -f "$worker_dir/exit" ] || [ -f "$worker_dir/done" ]; then
    die "worker is already complete: $1"
  fi

  tmux_name="$(cat "$worker_dir/tmux-name")"
  tmux kill-session -t "$tmux_name" 2>/dev/null || true
  printf '%s\n' cancelled >"$worker_dir/exit.tmp"
  mv "$worker_dir/exit.tmp" "$worker_dir/exit"
  printf '%s\n' "$1"
}

main() {
  [ "$#" -gt 0 ] || {
    usage
    exit 2
  }

  local command="$1"
  shift

  case "$command" in
    launch) launch_worker "$@" ;;
    resume) resume_worker "$@" ;;
    wait-any) wait_any "$@" ;;
    wait-all) wait_all "$@" ;;
    output) worker_output "$@" ;;
    exit-code) worker_exit_code "$@" ;;
    status) run_status "$@" ;;
    cancel) cancel_worker "$@" ;;
    -h|--help|help) usage ;;
    *)
      error "unknown command: $command"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
