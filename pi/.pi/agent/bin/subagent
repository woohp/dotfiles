#!/usr/bin/env bash
set -u
umask 077

program="${0##*/}"

usage() {
    cat <<'EOF'
Usage:
  subagent launch WORKER [--cwd PATH] [--provider NAME] [--model MODEL] [--thinking LEVEL] < PROMPT
  subagent launch-next PREFIX [--cwd PATH] [--provider NAME] [--model MODEL] [--thinking LEVEL] < PROMPT
  subagent resume WORKER [--provider NAME] [--model MODEL] [--thinking LEVEL] < PROMPT
  subagent wait-any WORKER...
  subagent wait-all WORKER...
  subagent output WORKER
  subagent exit-code WORKER
  subagent status
  subagent open WORKER [--parent SESSION_ID]
  subagent cancel WORKER

Commands:
  launch       Launch a specifically named worker's initial turn.
  launch-next  Atomically launch the first available PREFIX-N worker.
  resume       Launch a worker's next turn in the background.
  wait-any     Wait for and claim one selected worker completion.
  wait-all     Wait for and claim all selected worker completions.
  output       Print a worker's latest turn output.
  exit-code    Print a worker's latest turn exit code or "cancelled".
  status       Show each worker's latest turn state.
  open         Open a worker's Pi session interactively for inspection.
  cancel       Stop a running worker turn and record it as cancelled.

launch and resume return immediately. wait-any and wait-all are the blocking
commands. Worker names are mandatory for waits so callers explicitly own the
set of completions they consume.

Data is scoped by PI_SESSION_ID and stored under:
  ${SUBAGENT_STATE_DIR:-$HOME/.pi/agent/subagents}/<PI_SESSION_ID>/
EOF
}

error() {
    printf '%s: %s\n' "$program" "$*" >&2
}

die() {
    error "$@"
    exit 2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

absolute_dir() {
    (cd "$1" 2>/dev/null && pwd -P)
}

validate_component() {
    case "$2" in
    '' | *[!A-Za-z0-9_-]* | -*) die "invalid $1: $2" ;;
    esac
}

subagent_root_dir() {
    printf '%s\n' "${SUBAGENT_STATE_DIR:-$HOME/.pi/agent/subagents}"
}

subagent_parent_dir() {
    local parent_session_id="${PI_SESSION_ID:-}"

    [ -n "$parent_session_id" ] || die "PI_SESSION_ID is not set"
    validate_component "PI session ID" "$parent_session_id"
    printf '%s/%s\n' "$(subagent_root_dir)" "$parent_session_id"
}

ensure_parent_dir() {
    local parent_dir
    parent_dir="$(subagent_parent_dir)" || exit $?
    mkdir -p "$parent_dir/workers" "$parent_dir/sessions" ||
        die "cannot create subagent directory: $parent_dir"

    if [ ! -f "$parent_dir/parent-cwd" ]; then
        pwd -P >"$parent_dir/parent-cwd.tmp"
        mv "$parent_dir/parent-cwd.tmp" "$parent_dir/parent-cwd"
    fi

    printf '%s\n' "$parent_dir"
}

resolve_parent_dir() {
    local parent_dir
    parent_dir="$(subagent_parent_dir)" || exit $?
    [ -d "$parent_dir/workers" ] || die "this Pi session has no subagent workers"
    printf '%s\n' "$parent_dir"
}

resolve_worker() {
    local parent_dir="$1"
    local worker="$2"
    local worker_dir="$parent_dir/workers/$worker"
    validate_component "worker name" "$worker"
    [ -d "$worker_dir" ] || die "worker does not exist: $worker"
    printf '%s\n' "$worker_dir"
}

latest_turn_dir() {
    local worker_dir="$1"
    local turn
    turn="$(cat "$worker_dir/latest-turn")"
    case "$turn" in
    '' | *[!0-9]*) die "invalid latest turn for worker: $(basename "$worker_dir")" ;;
    esac
    [ -d "$worker_dir/turns/$turn" ] || die "latest turn directory is missing: $turn"
    printf '%s\n' "$worker_dir/turns/$turn"
}

add_pi_option() {
    case "$1" in
    --provider | --model | --thinking)
        [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 requires a value"
        pi_options+=("$1" "$2")
        ;;
    *) die "unknown option: $1" ;;
    esac
}

write_pi_options() {
    [ "${#pi_options[@]}" -eq 0 ] || printf '%s\n' "${pi_options[@]}" >"$1/pi-options"
}

start_turn() {
    local turn_dir="$1"

    # Job control gives the turn its own process group, so it survives the
    # caller's process-group kill and can be cancelled as a group.
    set -m
    nohup "$(realpath "$0")" __run "$turn_dir" </dev/null >/dev/null 2>&1 &
    set +m
    printf '%s\n' "$!" >"$turn_dir/pid"
}

run_turn() {
    local turn_dir="$1"
    local worker_dir="${turn_dir%/turns/*}"
    local turn="${turn_dir##*/}"
    local worker="${worker_dir##*/}"
    local sid
    local cwd
    local rc
    local option
    local pi_args
    local cancelled=0
    sid="$(cat "$worker_dir/session-id")"
    cwd="$(cat "$worker_dir/cwd")"

    # cancel signals the whole process group; Pi exits and the runner records it.
    trap 'cancelled=1' TERM
    if cd "$cwd"; then
        pi_args=(--session-dir "$(cat "$worker_dir/pi-session-dir")")
        if [ "$turn" = 1 ]; then
            pi_args+=(--session-id "$sid" --name "subagent:$worker")
        else
            pi_args+=(--session "$sid")
        fi
        if [ -f "$turn_dir/pi-options" ]; then
            while IFS= read -r option; do
                pi_args+=("$option")
            done <"$turn_dir/pi-options"
        fi

        pi "${pi_args[@]}" -p <"$turn_dir/prompt" >"$turn_dir/output" 2>&1
        rc=$?
    else
        printf 'Could not enter working directory: %s\n' "$cwd" >"$turn_dir/output"
        rc=125
    fi
    [ "$cancelled" -eq 0 ] || rc=cancelled

    printf '%s\n' "$rc" >"$turn_dir/exit.tmp"
    mv "$turn_dir/exit.tmp" "$turn_dir/exit"
}

turn_process_alive() {
    local turn_dir="$1"
    local pid

    pid="$(cat "$turn_dir/pid" 2>/dev/null)" || return 1
    # Match the command line too, so a reused PID is not mistaken for the turn.
    ps -ww -p "$pid" -o command= 2>/dev/null | grep -qF -- "__run $turn_dir"
}

launch_worker() {
    local allocation="$1"
    shift
    [ "$#" -ge 1 ] || die "usage: $program launch WORKER [--cwd PATH] [--provider NAME] [--model MODEL] [--thinking LEVEL]"

    local requested_name="$1"
    local worker="$requested_name"
    local cwd="$PWD"
    local pi_options=()
    local number=1
    shift

    while [ "$#" -gt 0 ]; do
        case "$1" in
        --cwd)
            [ "$#" -ge 2 ] || die "--cwd requires a path"
            cwd="$2"
            ;;
        *) add_pi_option "$@" ;;
        esac
        shift 2
    done

    if [ "$allocation" = next ]; then
        validate_component "worker prefix" "$requested_name"
    else
        validate_component "worker name" "$worker"
    fi
    cwd="$(absolute_dir "$cwd")" || die "working directory does not exist: $cwd"
    require_command pi
    require_command uuidgen

    local parent_dir
    local worker_dir
    local turn_dir
    local pi_session_dir
    local sid
    parent_dir="$(ensure_parent_dir)" || exit $?
    pi_session_dir="$parent_dir/sessions"

    if [ "$allocation" = next ]; then
        while :; do
            worker="${requested_name}-${number}"
            worker_dir="$parent_dir/workers/$worker"
            if mkdir "$worker_dir" 2>/dev/null; then
                break
            fi
            [ -e "$worker_dir" ] || die "cannot allocate worker name with prefix: $requested_name"
            number=$((number + 1))
        done
    else
        worker_dir="$parent_dir/workers/$worker"
        mkdir "$worker_dir" 2>/dev/null || die "worker already exists: $worker"
    fi

    turn_dir="$worker_dir/turns/1"
    mkdir -p "$turn_dir" || die "cannot initialize worker: $worker"

    sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"

    printf '%s\n' "$sid" >"$worker_dir/session-id"
    printf '%s\n' "$cwd" >"$worker_dir/cwd"
    printf '%s\n' "$pi_session_dir" >"$worker_dir/pi-session-dir"
    printf '%s\n' 1 >"$worker_dir/latest-turn"
    write_pi_options "$turn_dir"
    cat >"$turn_dir/prompt"
    start_turn "$turn_dir"
    printf '%s\n' "$worker"
}

resume_worker() {
    [ "$#" -ge 1 ] || die "usage: $program resume WORKER [--provider NAME] [--model MODEL] [--thinking LEVEL]"

    local worker="$1"
    local pi_options=()
    shift

    while [ "$#" -gt 0 ]; do
        add_pi_option "$@"
        shift 2
    done

    require_command pi

    local parent_dir
    local worker_dir
    local previous_turn_dir
    local previous_turn
    local turn
    local turn_dir
    parent_dir="$(resolve_parent_dir)" || exit $?
    worker_dir="$(resolve_worker "$parent_dir" "$worker")" || exit $?
    previous_turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?
    previous_turn="$(cat "$worker_dir/latest-turn")"

    if [ -f "$previous_turn_dir/exit" ]; then
        die "worker completion is unconsumed; call wait-any or wait-all first: $worker"
    fi
    [ -f "$previous_turn_dir/done" ] || die "worker is still running: $worker"

    turn=$((previous_turn + 1))
    turn_dir="$worker_dir/turns/$turn"
    mkdir "$turn_dir" || die "cannot create turn $turn for worker: $worker"
    write_pi_options "$turn_dir"
    cat >"$turn_dir/prompt"
    printf '%s\n' "$turn" >"$worker_dir/latest-turn.tmp"
    mv "$worker_dir/latest-turn.tmp" "$worker_dir/latest-turn"
    start_turn "$turn_dir"
    printf '%s\n' "$worker"
}

selected_turns() {
    local parent_dir="$1"
    shift
    local worker
    local worker_dir
    local turn_dir

    for worker in "$@"; do
        worker_dir="$(resolve_worker "$parent_dir" "$worker")" || exit $?
        turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?
        printf '%s\t%s\n' "$worker" "$turn_dir"
    done
}

wait_any() {
    [ "$#" -ge 1 ] || die "usage: $program wait-any WORKER..."

    local parent_dir
    local selected
    local worker
    local turn_dir
    local unfinished
    parent_dir="$(resolve_parent_dir)" || exit $?
    selected="$(selected_turns "$parent_dir" "$@")" || exit $?

    while :; do
        unfinished=0

        while IFS=$'\t' read -r worker turn_dir; do
            [ -n "$worker" ] || continue

            if [ -f "$turn_dir/exit" ]; then
                if mv "$turn_dir/exit" "$turn_dir/done" 2>/dev/null; then
                    printf '%s\n' "$worker"
                    return 0
                fi
            fi

            [ -f "$turn_dir/done" ] || unfinished=$((unfinished + 1))
        done <<<"$selected"

        [ "$unfinished" -gt 0 ] || return 1
        sleep 0.2
    done
}

wait_all() {
    [ "$#" -ge 1 ] || die "usage: $program wait-all WORKER..."

    local worker
    local rc
    while :; do
        worker="$(wait_any "$@")"
        rc=$?
        case "$rc" in
        0) printf '%s\n' "$worker" ;;
        1) return 0 ;;
        *) return "$rc" ;;
        esac
    done
}

worker_output() {
    [ "$#" -eq 1 ] || die "usage: $program output WORKER"

    local parent_dir
    local worker_dir
    local turn_dir
    parent_dir="$(resolve_parent_dir)" || exit $?
    worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?
    turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?
    [ -f "$turn_dir/output" ] || die "worker has no output for its latest turn: $1"
    cat "$turn_dir/output"
}

worker_exit_code() {
    [ "$#" -eq 1 ] || die "usage: $program exit-code WORKER"

    local parent_dir
    local worker_dir
    local turn_dir
    parent_dir="$(resolve_parent_dir)" || exit $?
    worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?
    turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?

    if [ -f "$turn_dir/done" ]; then
        cat "$turn_dir/done"
    elif [ -f "$turn_dir/exit" ]; then
        cat "$turn_dir/exit"
    else
        die "worker has not completed its latest turn: $1"
    fi
}

turn_state() {
    local turn_dir="$1"

    if turn_process_alive "$turn_dir"; then
        printf 'running\t-\n'
    elif [ -f "$turn_dir/done" ]; then
        printf 'consumed\t%s\n' "$(cat "$turn_dir/done")"
    elif [ -f "$turn_dir/exit" ]; then
        printf 'completed\t%s\n' "$(cat "$turn_dir/exit")"
    else
        printf 'lost\t-\n'
    fi
}

run_status() {
    [ "$#" -eq 0 ] || die "usage: $program status"

    local parent_dir
    local worker_dir
    local turn_dir
    local turn
    local found=0
    local status_and_exit
    local worker_status
    local code
    parent_dir="$(resolve_parent_dir)" || exit $?

    printf '%-20s %-6s %-10s %s\n' WORKER TURN STATE EXIT
    for worker_dir in "$parent_dir/workers"/*; do
        [ -d "$worker_dir" ] || continue
        found=1
        turn="$(cat "$worker_dir/latest-turn")"
        turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?
        status_and_exit="$(turn_state "$turn_dir")"
        worker_status="${status_and_exit%%	*}"
        code="${status_and_exit#*	}"
        printf '%-20s %-6s %-10s %s\n' \
            "$(basename "$worker_dir")" "$turn" "$worker_status" "$code"
    done

    [ "$found" -eq 1 ] || printf '%s\n' '(no workers)'
}

cancel_worker() {
    [ "$#" -eq 1 ] || die "usage: $program cancel WORKER"

    local parent_dir
    local worker_dir
    local turn_dir
    parent_dir="$(resolve_parent_dir)" || exit $?
    worker_dir="$(resolve_worker "$parent_dir" "$1")" || exit $?
    turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?

    if turn_process_alive "$turn_dir"; then
        # The runner records the cancelled completion as it exits.
        kill -TERM -- "-$(cat "$turn_dir/pid")" 2>/dev/null
    elif [ -f "$turn_dir/exit" ] || [ -f "$turn_dir/done" ]; then
        die "worker's latest turn is already complete: $1"
    else
        # Lost turn: no runner is left to record a completion.
        printf '%s\n' cancelled >"$turn_dir/exit.tmp"
        mv "$turn_dir/exit.tmp" "$turn_dir/exit"
    fi
    printf '%s\n' "$1"
}

open_worker() {
    [ "$#" -ge 1 ] || die "usage: $program open WORKER [--parent SESSION_ID]"

    local worker="$1"
    local parent_session_id="${PI_SESSION_ID:-}"
    local parent_dir
    local worker_dir
    local turn_dir
    local sid
    local cwd
    local subagent_root
    local candidate
    local current_cwd
    local matches=0
    shift

    while [ "$#" -gt 0 ]; do
        case "$1" in
        --parent)
            [ "$#" -ge 2 ] || die "--parent requires a session ID"
            parent_session_id="$2"
            shift 2
            ;;
        *) die "unknown open option: $1" ;;
        esac
    done

    validate_component "worker name" "$worker"
    subagent_root="$(subagent_root_dir)"

    if [ -n "$parent_session_id" ]; then
        validate_component "PI session ID" "$parent_session_id"
        parent_dir="$subagent_root/$parent_session_id"
        [ -d "$parent_dir/workers" ] ||
            die "parent session has no subagent workers: $parent_session_id"
    else
        current_cwd="$(absolute_dir "$PWD")"
        parent_dir=""

        for candidate in "$subagent_root"/*; do
            [ -d "$candidate/workers/$worker" ] || continue

            [ "$(cat "$candidate/parent-cwd")" = "$current_cwd" ] || continue
            parent_dir="$candidate"
            matches=$((matches + 1))
        done

        [ "$matches" -gt 0 ] || die "worker not found for current directory: $worker"
        if [ "$matches" -gt 1 ]; then
            die "multiple parent sessions contain $worker for this directory; use --parent SESSION_ID"
        fi
    fi

    worker_dir="$(resolve_worker "$parent_dir" "$worker")" || exit $?
    turn_dir="$(latest_turn_dir "$worker_dir")" || exit $?
    if [ ! -f "$turn_dir/exit" ] && [ ! -f "$turn_dir/done" ]; then
        error "warning: $worker is running; this is a non-live snapshot, do not submit concurrently"
    fi

    require_command pi
    sid="$(cat "$worker_dir/session-id")"
    cwd="$(cat "$worker_dir/cwd")"
    cd "$cwd" || die "working directory does not exist: $cwd"
    exec pi --session-dir "$(cat "$worker_dir/pi-session-dir")" --session "$sid"
}

main() {
    [ "$#" -gt 0 ] || {
        usage
        exit 2
    }

    local command="$1"
    shift

    case "$command" in
    launch) launch_worker exact "$@" ;;
    launch-next) launch_worker next "$@" ;;
    resume) resume_worker "$@" ;;
    wait-any) wait_any "$@" ;;
    wait-all) wait_all "$@" ;;
    output) worker_output "$@" ;;
    exit-code) worker_exit_code "$@" ;;
    status) run_status "$@" ;;
    open) open_worker "$@" ;;
    cancel) cancel_worker "$@" ;;
    __run) run_turn "$@" ;;
    -h | --help | help) usage ;;
    *)
        error "unknown command: $command"
        usage >&2
        exit 2
        ;;
    esac
}

# Turns run from this file for minutes; exiting on the same line keeps bash from
# reading past main if the script is edited in place meanwhile.
main "$@"; exit
